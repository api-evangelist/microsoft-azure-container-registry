{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Container Registry REST Blobs Tags API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ACR List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{registry}.azurecr.io/v2/:name/tags/list",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists tags for a repository."
        }
      ]
    }
  ],
  "bundled": true
}