{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Container Registry REST Blobs API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Blobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ACR Get blob",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{registry}.azurecr.io/v2/:name/blobs/:digest",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "digest",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a blob by digest."
        }
      ]
    }
  ],
  "bundled": true
}